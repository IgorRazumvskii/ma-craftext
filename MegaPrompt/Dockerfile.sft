FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/huggingface \
    TMPDIR=/data/tmp

COPY MegaPrompt/docker/requirements-sft.txt /tmp/requirements-sft.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-sft.txt

# The converter resolves CrafText and MA-Craftax relative to this project layout.
COPY MegaPrompt /workspace/ma-craftext/MegaPrompt
COPY CrafText /workspace/ma-craftext/CrafText
COPY MultyAgentCrafText/MA-Craftax /workspace/ma-craftext/MultyAgentCrafText/MA-Craftax
WORKDIR /workspace/ma-craftext/MegaPrompt

ENTRYPOINT ["python", "scripts/run_mappo_sft_hf.py"]
